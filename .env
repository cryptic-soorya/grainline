# Copy this file to .env.local and fill in real values from your Firebase
# project settings (Firebase Console → Project Settings → General → Your apps).
# .env.local is already git-ignored — never commit real credentials.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Phase 6 — deadline push notifications. Public/private keypair for Web
# Push, generated once with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URL required by the Web Push protocol so push services can reach
# you if a subscription is being abused, e.g. mailto:you@example.com
VAPID_SUBJECT=

# Server-only Firebase Admin credentials, from Firebase Console → Project
# Settings → Service Accounts → Generate new private key. Needed because the
# reminders cron reads every user's deadlines, which the client SDK's
# owner-only security rules correctly won't allow.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Shared secret the cron route checks for in its Authorization header, so
# it can't be triggered by anyone who finds the URL.
CRON_SECRET=
